<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>StudyVault — Digital Products</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f7f7fb;
      color: #222;
    }

    header {
      background: #111827;
      color: white;
      padding: 18px 8%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .logo {
      font-size: 24px;
      font-weight: bold;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 25px;
    }

    .hero {
      padding: 80px 8%;
      text-align: center;
      background: linear-gradient(135deg, #4f46e5, #7c3aed);
      color: white;
    }

    .hero h1 {
      font-size: 48px;
      margin-bottom: 20px;
    }

    .hero p {
      font-size: 19px;
      max-width: 650px;
      margin: auto;
      line-height: 1.6;
    }

    .hero button {
      margin-top: 30px;
      padding: 14px 28px;
      border: none;
      border-radius: 8px;
      background: white;
      color: #4f46e5;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    .products {
      padding: 60px 8%;
    }

    .products h2 {
      text-align: center;
      margin-bottom: 40px;
      font-size: 32px;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
    }

    .card {
      background: white;
      border-radius: 15px;
      padding: 25px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.08);
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-5px);
    }

    .icon {
      font-size: 45px;
      margin-bottom: 15px;
    }

    .card h3 {
      margin-bottom: 10px;
    }

    .card p {
      color: #666;
      line-height: 1.5;
      margin-bottom: 20px;
    }

    .price {
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 20px;
    }

    .buy-btn {
      display: block;
      text-align: center;
      background: #4f46e5;
      color: white;
      padding: 12px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: bold;
    }

    .about {
      padding: 60px 8%;
      background: white;
      text-align: center;
    }

    .about h2 {
      margin-bottom: 15px;
    }

    .about p {
      max-width: 700px;
      margin: auto;
      color: #666;
      line-height: 1.7;
    }

    footer {
      background: #111827;
      color: white;
      text-align: center;
      padding: 25px;
    }

    @media (max-width: 600px) {
      .hero h1 {
        font-size: 36px;
      }

      nav {
        display: none;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">📚 StudyVault</div>

    <nav>
      <a href="#home">Home</a>
      <a href="#products">Products</a>
      <a href="#about">About</a>
    </nav>
  </header>

  <section class="hero" id="home">
    <h1>Study Smarter. Learn Faster.</h1>

    <p>
      Get high-quality digital study resources, exam notes,
      formula sheets, and useful templates — all in one place.
    </p>

    <button onclick="document.getElementById('products').scrollIntoView()">
      Explore Products
    </button>
  </section>

  <section class="products" id="products">

    <h2>Popular Products</h2>

    <div class="product-grid">

      <div class="card">
        <div class="icon">📖</div>
        <h3>Exam Notes PDF</h3>
        <p>
          Easy-to-understand notes designed to help students
          prepare efficiently for exams.
        </p>

        <div class="price">₹99</div>

        <a
          class="buy-btn"
          href="https://wa.me/919999999999?text=Hi,%20I%20want%20to%20buy%20Exam%20Notes%20PDF"
          target="_blank">
          Buy Now
        </a>
      </div>


      <div class="card">
        <div class="icon">🧮</div>
        <h3>Formula Sheet</h3>
        <p>
          A quick-reference collection of important formulas
          for last-minute exam revision.
        </p>

        <div class="price">₹49</div>

        <a
          class="buy-btn"
          href="https://wa.me/919999999999?text=Hi,%20I%20want%20to%20buy%20Formula%20Sheet"
          target="_blank">
          Buy Now
        </a>
      </div>


      <div class="card">
        <div class="icon">📝</div>
        <h3>Study Planner</h3>
        <p>
          Organize your daily study sessions and keep track
          of your goals with this digital planner.
        </p>

        <div class="price">₹79</div>

        <a
          class="buy-btn"
          href="https://wa.me/919999999999?text=Hi,%20I%20want%20to%20buy%20Study%20Planner"
          target="_blank">
          Buy Now
        </a>
      </div>

    </div>

  </section>


  <section class="about" id="about">

    <h2>Why StudyVault?</h2>

    <p>
      We create simple, useful, and affordable digital resources
      to help students save time and study more effectively.
    </p>

  </section>


  <footer>
    <p>© 2026 StudyVault. All rights reserved.</p>
  </footer>


  <script>

    // Simple welcome message
    console.log("Welcome to StudyVault!");

  </script>

</body>
</html>